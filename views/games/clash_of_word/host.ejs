<%- include("../../partials/htmlhead.ejs") %>

<main id="lobby-host" hx-ext="ws" hx-ws:connect="/host">
  <h1>Clash Of Word</h1>

  <section id="game-screen">
    <div>
      <div>Lobby code</div>
      <div id="lobby-code">Waiting for code to generate</div>
    </div>

    <br>
    <div>Joined Player</div>
    <ul id="joined-player">
      <% for( let index = 0; index < playerJoined.length; index++ ) { %>
      <li><%= playerJoined[index].username %> Joined</li>
      <% } %>
    </ul>

    <div id="startButton">
      <% if (startable) { %>
      <button hx-ws:send hx-vals='{"type": "startGame", "start": "true"}' class="bg-success-bg text-success-text hover:bg-success-text hover:text-success-bg  p-1 rounded">
        <!-- TODO add interactivity -->
        All Player Joined! play Now!
      </button>
      <% } else { %>
      <button class="bg-gray-400 text-black p-1 rounded">Not Enough Player</button>
      <% } %>
    </div>
  </section>
</main>

<%- include("../../partials/htmlend.ejs") %>
