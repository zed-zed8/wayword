<div>Round <%= round.round %></div>
<div>Result</div>
<div>player 1 word: <%= round.word1 %></div>
<div>player 1 score: <%= round.score1 %></div>
<div>player 2 word: <%= round.word2 %></div>
<div>player 2 score: <%= round.score2 %></div>
<div><%= winningPlayer %> attack with: <%= difference %></div>
<div>result: <%= round.result %></div>

<% if (isEnd) { %>
<button hx-ws:send hx-vals='{"type": "endGame"}' class="p-1 bg-rose-700">End</button>
<% } else { %>
<button hx-ws:send hx-vals='{"type": "startGame"}' class="p-1 bg-green-800">Continue Game</button>
<% } %>
