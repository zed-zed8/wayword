<section id="register">
  <form
    id="registerForm"
    hx-post="/register"
    hx-target="#body"
    hx-swap="innerMorph"
    hx-headers='{"Content-Type": "application/x-www-form-urlencoded"}'
  >
    <h1>Register Form</h1>

    <label for="username">Username : </label>
    <input
      type="text"
      id="username"
      name="username"
      autocomplete="off"
      placeholder="username..."
      required
    />
    <br />

    <label for="email">Email : </label>
    <input
      type="email"
      id="email"
      name="email"
      autocomplete="off"
      placeholder="email..."
      required
    />
    <br />

    <label for="password">Password : </label>
    <input
      type="password"
      id="password"
      name="password"
      autocomplete="off"
      placeholder="password..."
      required
    />
    <br />

    <button class="bg-brand-primary">Register</button>
  </form>

  <a
    hx-target="#main"
    hx-swap="innerMorph"
    hx-push-url="true"
    hx-get="/login"
    class="text-info-text underline decoration-info-text"
    >Login</a
  >
</section>
