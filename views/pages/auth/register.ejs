<section id="register">
  <form id="registerForm" method="post" action="/register" hx-target="body" hx-swap="innerMorph">
    <h1>Register Form</h1>

    <label for="username">Username : </label>
    <input type="text" id="username" name="username" autocomplete="off" placeholder="username..." required />
    <br />

    <label for="email">Email : </label>
    <input type="email" id="email" name="email" autocomplete="off" placeholder="email..." required />
    <br />

    <label for="password">Password : </label>
    <input type="password" id="password" name="password" autocomplete="off" placeholder="password..." required />
    <br />

    <button type="submit" class="bg-brand-primary">Register</button>
  </form>

  <a href="/login" hx-target="#main" hx-swap="innerMorph" class="text-info-text underline decoration-info-text">Login</a>

  <div id="message"></div>
</section>
