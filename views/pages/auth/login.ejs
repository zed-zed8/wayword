<section id="login">
  <form id="loginForm" method="post" action="/login" hx-target="body" hx-swap="innerMorph">
    <h1>Login Form</h1>

    <label for="username">Username : </label>
    <input type="text" id="username" name="username" autocomplete="off" placeholder="username..." required />
    <br />

    <label for="password">Password : </label>
    <input type="password" id="password" name="password" autocomplete="off" placeholder="password..." required />
    <br />

    <button type="submit" class="bg-brand-primary">Login</button>
  </form>

  <a href="/register" hx-target="#main" hx-swap="innerMorph" class="text-info-text underline decoration-info-text">Register</a>
</section>
