<header>
  <nav class="flex p-3 bg-brand-primary text-brand-primary-text">
    <div class="">WayWord</div>

    <ul hx-target:inherited="#main" hx-swap:inherited="innerMorph" class="flex ms-auto me-auto gap-3">
      <li>
        <a href="/home" class="text-info-text underline decoration-info-text">Home</a>
      </li>
      <li>
        <a href="/games" class="text-info-text underline decoration-info-text">Games</a>
      </li>
      <li>
        <a href="/about" class="text-info-text underline decoration-info-text">About</a>
      </li>
    </ul>

    <div id="profile">
      <% if (currentUser) { %>
      <a href="/profile/<%= currentUser._id %>" hx-target="main" hx-swap="innerMorph">
        <%= currentUser.username %>
      </a>
      <% } else { %>
      <a href="/login" hx-target="main" hx-swap="innerMorph" class="text-info-text underline decoration-info-text">Login</a>
      <% } %>
    </div>
  </nav>
</header>
